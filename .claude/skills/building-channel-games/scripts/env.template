# TEMPLATE - copy into your game repo and adapt. No secrets/paths baked in.
#
# GAMENAME docker-compose configuration. Copy to `.env` and edit.
#   cp env.template docker/.env

# ── Polygon (chain 137) ──────────────────────────────────────────────────────
# JSON-RPC endpoint. Used by XayaX (indexing) AND baked into the frontend
# bundle. The public Xaya node may rate-limit under load - prefer your own
# node or a provider (Alchemy / QuickNode / etc).
POLYGON_RPC=https://polygon-node.xaya.io
NEXT_PUBLIC_POLYGON_RPC=https://polygon-node.xaya.io

# REQUIRED for a fresh GSP: a Polygon block height just below the current
# head (approx head - 100), else the GSP can never catch up. Find the head:
#   cast block-number --rpc-url "$POLYGON_RPC"      # Foundry
# Re-using an existing datadir? The saved state wins; any value is fine then.
POLYGON_START_HEIGHT=

# ── Relay (separate repo github.com/xaya/xaya-relay) ─────────────────────────
# Private during the curated phase - access on request; see EXAMPLES.md for how
# to ask. Build it once (git clone ... && docker build -t xaya-relay .); run ONE
# instance per game - each relay polls a single GSP_URL.
RELAY_IMAGE=xaya-relay
# Feeds BOTH the relay service (RELAY_AUTH_AUDIENCE) and the frontend build
# (NEXT_PUBLIC_RELAY_AUDIENCE) from this one var, so client and server can't
# drift. Any string; unique per game is safest. NOTE: some client builds fall
# back to the shared "xayaships-relay-v1" if their audience is unset - always
# set this and let the compose file pass it to BOTH sides, so they agree.
RELAY_AUDIENCE=GAMENAME-relay-v1

# ── XayaX (separate public project github.com/xaya/xayax) ───────────────────
XAYAX_IMAGE=xaya/xayax

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port for the website (container listens on 3000).
FRONTEND_PORT=8109
# Optional WalletConnect (mobile/QR) project id. Injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# ── Game id ───────────────────────────────────────────────────────────────────
# The Xaya `g/` move namespace this deployment plays. For an ISOLATED game
# (e.g. a wager beta) set BOTH of these to the same id - the GSP (--game_id)
# and the frontend bundle must agree, and for wagering it must also equal the
# contract's game namespace.
GAME_ID=<gamename>
NEXT_PUBLIC_GAME_ID=<gamename>

# ── Wagering (OPTIONAL - leave blank for free-play only) ────────────────────
# See WAGERING.md for the full runbook. Order matters: deploy the contract
# FIRST, then set these and bring the stack up on a FRESH GSP datadir (the
# bootstrap step only fires once, on an empty database).
#
# Deployed wager contract address. Empty disables the wager UI in the frontend.
# ⚠️ The var name must EXACTLY match what your frontend code reads at build
# time (e.g. Xayaman's skill-wager.ts reads NEXT_PUBLIC_XAYAMAN_WAGER_ADDRESS)
# - a mismatched name is silently dropped and the wager UI stays free-only.
NEXT_PUBLIC_WAGER_ADDRESS=
# Operator/house wallet that seeds the payment-queue front (and receives draw
# pots + fees). Seeds ONCE, on a fresh datadir. Empty = wagering disabled in the GSP.
BOOTSTRAP_QUEUE_ADDRESS=
# Comma-separated raw (8-dp) WCHI paid tiers to pre-seed, one queue per tier.
# Example for tiers 10 / 100 / 1000 WCHI:
BOOTSTRAP_QUEUE_TIERS=1000000000,10000000000,100000000000
