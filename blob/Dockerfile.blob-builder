# The blob builder. Everything that can change the output bytes is pinned here.
#
# The rules blob is content-addressed: the chain knows it by its sha256, and every node
# runs exactly those bytes. So the toolchain is not an implementation detail, it is part
# of the artifact. A different wasi-sdk point release produces a different blob -- the
# wasm `producers` section records the exact clang build.
#
# Pinned by version AND sha256: the download fails closed if upstream ever moves the bytes
# under the tag.
FROM --platform=linux/amd64 debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils \
  && rm -rf /var/lib/apt/lists/*

ARG WASI_SDK_VERSION=24.0
ARG WASI_SDK_MAJOR=24
ARG WASI_SDK_SHA256=c6c38aab56e5de88adf6c1ebc9c3ae8da72f88ec2b656fb024eda8d4167a0bc5
RUN set -eux; \
  f="wasi-sdk-${WASI_SDK_VERSION}-x86_64-linux"; \
  curl -fsSLo /tmp/wasi-sdk.tar.gz \
    "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_MAJOR}/${f}.tar.gz"; \
  echo "${WASI_SDK_SHA256}  /tmp/wasi-sdk.tar.gz" | sha256sum -c -; \
  mkdir -p /opt/wasi-sdk; \
  tar -xzf /tmp/wasi-sdk.tar.gz -C /opt/wasi-sdk --strip-components=1; \
  rm -f /tmp/wasi-sdk.tar.gz; \
  /opt/wasi-sdk/bin/clang++ --version

ENV WASI_SDK=/opt/wasi-sdk

# THE STRIP, pinned as ONE command, inside the image.
#
# A host-local llvm-strip and this container's have been measured to disagree by two
# bytes -- which is the entire reason the build is containerized. And `llvm-strip
# --strip-debug` (a post-link pass) and `-Wl,--strip-debug` (a linker flag) produce
# DIFFERENT bytes: the linker rewrites the wasm `name` section differently. So the strip
# lives here, as a single fixed command with no arguments to get wrong, and
# build-blob.sh calls it by name. Changing this line changes the on-chain artifact.
RUN printf '#!/bin/sh\nset -eu\nexec /opt/wasi-sdk/bin/llvm-strip --strip-debug "$1"\n' \
      > /usr/local/bin/strip-blob \
 && chmod +x /usr/local/bin/strip-blob
