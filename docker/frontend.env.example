# Build args for docker/Dockerfile.frontend, consumed by scripts/build-frontend-image.sh.
#   NEXT_PUBLIC_GAME_ID=svpenaltypulse scripts/build-frontend-image.sh
#
# The `g/` move namespace this deployment plays. MUST equal the GSP's --game_id (the platform's
# GAME_ID). The default below is this game's namespace; an isolated deployment sets both.
NEXT_PUBLIC_GAME_ID=svpenaltypulse
# Blank = the runtime resilient RPC pair. A fork-testing deployment sets /chain and
# CHAIN_PROXY_DESTINATION.
NEXT_PUBLIC_POLYGON_RPC=
# Optional WalletConnect project id (injected wallets work without it).
NEXT_PUBLIC_WC_PROJECT_ID=
# "1" bakes in the test-wallet buttons (fork and playground deployments only). Empty for a
# real-money deployment (fully inert).
NEXT_PUBLIC_DEV_WALLET=
# The Arcade shell origin allowed to embed + message this game. Empty = standalone.
# MUST agree with FRAME_ANCESTORS, which is set at RUNTIME on the container.
NEXT_PUBLIC_ARCADE_ORIGIN=
# Same-origin proxy destinations, baked into the routes manifest at build time.
WS_PROXY_DESTINATION=http://arcade-relay:8081/
CHAIN_PROXY_DESTINATION=
GSP_PROXY_DESTINATION=
