# ConnectKit's peer deps lag React 19, so installs need legacy-peer-deps. Setting it here
# means a plain `npm install` works (and matches the Docker build's
# `npm ci --legacy-peer-deps`) without every dev having to remember the flag.
#
# CONSEQUENCE, and it is load-bearing: this flag DISABLES npm's automatic peer
# installation. Every peer @xayaarcade/sdk declares must therefore appear in this repo's
# own `dependencies` - see package.json.
legacy-peer-deps=true
